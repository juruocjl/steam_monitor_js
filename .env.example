# API 端口
PORT=3000

# API 监听地址（Docker host 网络部署时应设为 127.0.0.1，避免暴露公网）
API_BIND_HOST=0.0.0.0

# Steam 本地化语言（默认 schinese）
STEAM_LANGUAGE=schinese

# Steam 登录超时时间（毫秒）
STEAM_LOGIN_TIMEOUT_MS=30000

# 连接错误连续失败多少次后由短重试转入低频自动恢复；其他未知错误达到上限会停止
STEAM_MAX_CONSECUTIVE_FAILURES=3

# 自动恢复指数退避：1、2、4、8、16、30、30... 分钟（默认值）
# 每轮先通过 Clash 探测 Steam CM，通路可用时才执行一次登录
STEAM_RECOVERY_BASE_MS=60000
STEAM_RECOVERY_MAX_MS=1800000

# Steam 返回 RateLimitExceeded 时不永久停止，改用更保守的 1、2、4、6、6... 小时冷却
STEAM_RATE_LIMIT_RECOVERY_BASE_MS=3600000
STEAM_RATE_LIMIT_RECOVERY_MAX_MS=21600000

# 是否启用 steam-user 内建自动重连（建议 false，使用本项目自定义重连）
STEAM_AUTO_RELOGIN=false

# Steam 出错时是否直接退出进程（建议 false，由本项目分级重试和自动恢复）
STEAM_CRASH_ON_ERROR=false

# 可选：Steam 登录连接使用 SOCKS 代理；配置后默认强制 WebSocket 443
STEAM_SOCKS_PROXY=
STEAM_WEB_COMPATIBILITY_MODE=false

# 可选：连接类错误时，通过 Mihomo 控制接口切换代理节点后再重试
CLASH_AUTO_FAILOVER_ENABLED=false
CLASH_CONTROLLER_URL=http://127.0.0.1:9090
CLASH_CONTROLLER_SECRET_FILE=
# 设为 auto（默认）或配置组名不存在时，自动识别当前订阅承载流量的主 Selector 策略组
CLASH_FAILOVER_GROUP=auto
# 上游关联 Selector 策略组（若偏离到单节点或其它分流，探测/切换前自动对齐回主策略组；不存在的组自动跳过；留空关闭）
CLASH_UPSTREAM_GROUPS=Steam,Final
# 使用 * 时从当前策略组动态枚举真实落地节点（自动排除嵌套策略组、虚拟节点与剩余流量/到期/网址等提示假节点）
CLASH_FAILOVER_CANDIDATES=Auto,Fallback
CLASH_FAILOVER_TEST_TIMEOUT_MS=8000
# 登录失败节点冷却时间（毫秒，默认 30 分钟）；覆盖默认 Steam CM :443 增强探测 URL（逗号分隔，空串禁用）
CLASH_FAILED_NODE_COOLDOWN_MS=1800000
# CLASH_FAILOVER_CM_TEST_URLS=https://cmp1-tyo3.steamserver.net:443/cmsocket/,https://cmp1-fra1.steamserver.net:443/cmsocket/

# 可选：若触发 Steam Guard，可填一次性验证码（推荐改用 STEAM_REFRESH_TOKEN）
STEAM_GUARD_CODE=

# SQLite 数据库文件路径（可选）
SQLITE_DB_PATH=./data/friend_game_history.db

# Steam 商店请求代理（可选）
HTTPS_PROXY=

# Steam 商店请求超时与重试配置（可选）
STEAM_STORE_TIMEOUT_MS=5000
STEAM_STORE_RETRY_TIMES=3
STEAM_STORE_RETRY_DELAY_MS=800

# 登录方式 1（推荐长期运行）
# 使用 refresh token 自动登录
STEAM_REFRESH_TOKEN=

# 登录方式 2
# 使用账号密码登录
STEAM_ACCOUNT_NAME=
STEAM_PASSWORD=
# 若密码包含 #，可直接填写；程序会按原始值读取

# 可选：机器名标识
STEAM_MACHINE_NAME=steam-monitor-js
