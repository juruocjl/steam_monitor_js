# API 端口
PORT=3000

# API 监听地址（Docker host 网络部署时应设为 127.0.0.1，避免暴露公网）
API_BIND_HOST=0.0.0.0

# Steam 本地化语言（默认 schinese）
STEAM_LANGUAGE=schinese

# Steam 登录超时时间（毫秒）
STEAM_LOGIN_TIMEOUT_MS=30000

# 普通登录错误连续失败多少次后停止自动重连（AccessDenied/RateLimitExceeded 会立即停止）
STEAM_MAX_CONSECUTIVE_FAILURES=3

# 是否启用 steam-user 内建自动重连（建议 false，使用本项目自定义重连）
STEAM_AUTO_RELOGIN=false

# Steam 出错时是否直接退出进程（建议 false，由本项目熔断重连，避免登录风暴）
STEAM_CRASH_ON_ERROR=false

# 可选：Steam 登录连接使用 SOCKS 代理；配置后默认强制 WebSocket 443
STEAM_SOCKS_PROXY=
STEAM_WEB_COMPATIBILITY_MODE=false

# 可选：连接类错误时，通过 Mihomo 控制接口切换代理节点后再重试
CLASH_AUTO_FAILOVER_ENABLED=false
CLASH_CONTROLLER_URL=http://127.0.0.1:9090
CLASH_CONTROLLER_SECRET_FILE=
CLASH_FAILOVER_GROUP=E-IX
CLASH_FAILOVER_CANDIDATES=Auto,Fallback
CLASH_FAILOVER_TEST_TIMEOUT_MS=8000

# 可选：若触发 Steam Guard，可填一次性验证码（推荐改用 STEAM_REFRESH_TOKEN）
STEAM_GUARD_CODE=

# SQLite 数据库文件路径（可选）
SQLITE_DB_PATH=./data/friend_game_history.db

# Steam 商店请求代理（可选）
HTTPS_PROXY=

# Steam 商店请求超时与重试配置（可选）
STEAM_STORE_TIMEOUT_MS=5000
STEAM_STORE_RETRY_TIMES=3
STEAM_STORE_RETRY_DELAY_MS=800

# 登录方式 1（推荐长期运行）
# 使用 refresh token 自动登录
STEAM_REFRESH_TOKEN=

# 登录方式 2
# 使用账号密码登录
STEAM_ACCOUNT_NAME=
STEAM_PASSWORD=
# 若密码包含 #，可直接填写；程序会按原始值读取

# 可选：机器名标识
STEAM_MACHINE_NAME=steam-monitor-js
